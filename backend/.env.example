# Copy this file to backend/.env and fill in real values. NEVER commit .env.
# All values below are placeholders. See docs/ENVIRONMENTS.md for the full workflow.

# --- PostgreSQL (Neon) ---
# Direct (non-pooled) connection string of a SEPARATE, disposable TEST branch.
# Every database tool and every test in this repository connects here by default.
DATABASE_URL_TEST=
# Pin the expected branch: output of `npm run db:whoami` (neon.branch_id), e.g. br-xxxx-xxxx.
# Required by seed/reset; verified by every test suite when set.
TEST_BRANCH_ID=

# DEV branch (not migrated until you decide to; see docs/ENVIRONMENTS.md step 4).
# Direct string, used ONLY by `db:migrate`/`db:inspect --target=dev`:
DATABASE_URL_DIRECT=
# Pooled string, used by `npm start`:
DATABASE_URL=
# Branch id you intend to migrate (verified before any statement). The gate itself,
# ALLOW_DEV_TARGET=true, is passed on the command line and never stored here.
DEV_BRANCH_ID=

# --- API ---
PORT=4000
# Interface to bind. Loopback by default; use 0.0.0.0 only behind a trusted proxy/container.
# HOST=127.0.0.1
NODE_ENV=development
# REQUIRED. Random secret for signing access tokens, at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Optional (defaults shown)
# JWT_TTL_SECONDS=3600
# BCRYPT_COST=12
# LOCK_TIMEOUT_MS=3000
# CORS_ORIGINS=http://localhost:5173
# TRUST_PROXY=false
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_LOGIN_MAX=10
# RATE_LIMIT_REGISTER_MAX=10
# RATE_LIMIT_PUBLIC_READ_MAX=600

# --- Command-line gates (pass on the command line, do not store here) ---
# ALLOW_SEED=true          npm run db:seed        (truncates the TEST branch's BookLoop tables)
# ALLOW_RESET=true --yes   npm run db:reset       (drops the TEST branch's public schema)
# ALLOW_DEV_TARGET=true    npm run db:migrate -- --target=dev
# SEED_PASSWORD=...        optional override of the development-only seed account password
