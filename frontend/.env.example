# Public address of the BookLoop API (the backend listens on 127.0.0.1:4000 by default).
# Use 127.0.0.1 rather than "localhost": the backend binds IPv4 loopback and "localhost" can
# resolve to ::1 on Windows.
#
# NEVER put database URLs, passwords, JWT secrets or any other server-side secret in a VITE_* variable:
# everything prefixed VITE_ is bundled into the browser code and visible to every visitor.
VITE_API_BASE_URL=http://127.0.0.1:4000
